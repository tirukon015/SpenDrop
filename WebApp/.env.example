# SpenDrop Web App — copy to .env.local (never commit .env.local).
# Only PUBLIC values belong here: everything prefixed NEXT_PUBLIC_ is shipped to the browser.
# Never put a Supabase service-role key, database password or any other secret in this app.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key (preferred) …
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# … or the legacy anon key (used only if the publishable key is empty)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local demo with synthetic data kept in the browser (no Supabase needed). Development/testing only.
# NEXT_PUBLIC_SPENDROP_DEMO=1

# ---- SpenDrop AI ("Ask SpenDrop") — SERVER-ONLY settings (never prefix with NEXT_PUBLIC_). See ../Docs/AI-Architecture.md
# none = SpenDrop's own deterministic answers only (no model, no cost). ollama = local model. openai-compatible = hosted/self-hosted.
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_BASE_URL=https://your-openai-compatible-endpoint/v1
# AI_API_KEY=
# AI_TIMEOUT_MS=60000
# AI_DEBUG=1
