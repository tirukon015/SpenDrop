    },
    {
      "name": "Text that isn't a number is reported, not guessed",
      "total": 10000,
      "people": [
        "Riyad"
      ],
      "method": "amounts",
      "ops": [
        {
          "op": "autoCalculate",
          "value": false
        },
        {
          "op": "type",
          "who": "Me",
          "text": "abc"
        },
        {
          "op": "type",
          "who": "Riyad",
          "text": "100"
        }
      ],
      "expect": {
        "problem": "Enter a valid amount for You."
      }
    },
    {
      "name": "Equal among 3 (You, Riyad, Bijoy), paid by Riyad → exact sen",
      "total": 10000,
      "people": [
        "Riyad",
        "Bijoy"
      ],
      "method": "equal",
      "ops": [
