{
  "$comment": "Shared split cases. Every platform must reproduce these exactly (integer sen). Taken from the iOS test suites (Phase 4, Debts & settlements, Auto Calculate & fixed). Participants: 'Me' is always first; others in the order listed. ops are applied in order with the total known (like the editors do). 'shares' lists one amount per participant in participant order.",
  "cases": [
    { "name": "Equal RM10 among 3: leftover sen to Me (I paid)", "total": 1000, "people": ["A", "B"], "method": "equal",
      "expect": { "shares": [334, 333, 333] } },
    { "name": "Equal RM100 among 3", "total": 10000, "people": ["Vijay", "Riyadh"], "method": "equal",
      "expect": { "shares": [3334, 3333, 3333] } },
    { "name": "Equal RM150 among 3", "total": 15000, "people": ["A", "B"], "method": "equal",
      "expect": { "shares": [5000, 5000, 5000] } },
    { "name": "Parts Me 2 / A 1 / B 1", "total": 10000, "people": ["A", "B"], "method": "parts",
      "ops": [{ "op": "parts", "who": "Me", "value": 2 }], "expect": { "shares": [5000, 2500, 2500] } },
    { "name": "Auto Calculate: Me typed 0.01 of RM7 -> Bijoy 6.99", "total": 700, "people": ["Bijoy"], "method": "amounts",
      "ops": [{ "op": "type", "who": "Me", "text": "0.01" }], "expect": { "shares": [1, 699] } },
    { "name": "Regression: Vijay typed RM50 of RM200 -> Me is NOT RM0 (75/50/75)", "total": 20000, "people": ["Vijay", "Riyadh"], "method": "amounts",
      "ops": [{ "op": "type", "who": "Vijay", "text": "50" }], "expect": { "shares": [7500, 5000, 7500] } },
    { "name": "Fixed amount: Vijay fixed RM50 of RM200 -> 50/100/50", "total": 20000, "people": ["Vijay", "Riyadh"], "method": "amounts",
      "ops": [{ "op": "fixed", "who": "Vijay", "minor": 5000 }], "expect": { "shares": [5000, 10000, 5000] } },
    { "name": "Two fixed amounts: RM300, Vijay 60, Riyadh 40", "total": 30000, "people": ["Vijay", "Riyadh"], "method": "amounts",
      "ops": [{ "op": "fixed", "who": "Vijay", "minor": 6000 }, { "op": "fixed", "who": "Riyadh", "minor": 4000 }],
      "expect": { "shares": [6667, 12667, 10666] } },
    { "name": "Fixed amount for Me: RM200, Me fixed 60", "total": 20000, "people": ["Vijay", "Riyadh"], "method": "amounts",
      "ops": [{ "op": "fixed", "who": "Me", "minor": 6000 }], "expect": { "shares": [10667, 4667, 4666] } },
    { "name": "Fixed with sen: RM150.50, Vijay fixed RM50.50", "total": 15050, "people": ["Vijay", "Riyadh"], "method": "amounts",
      "ops": [{ "op": "fixed", "who": "Vijay", "minor": 5050 }], "expect": { "shares": [3334, 8383, 3333] } },
    { "name": "Fixed amounts exceed total", "total": 10000, "people": ["Vijay", "Riyadh"], "method": "amounts",
      "ops": [{ "op": "fixed", "who": "Vijay", "minor": 8000 }, { "op": "fixed", "who": "Riyadh", "minor": 3000 }],
      "expect": { "problem": "Fixed amounts exceed the expense total by RM 10.00." } },
    { "name": "Auto Calculate OFF: 70/50/50 of RM200 stays as typed", "total": 20000, "people": ["Vijay", "Riyadh"], "method": "amounts",
      "ops": [{ "op": "autoCalculate", "value": false }, { "op": "type", "who": "Me", "text": "70" },
              { "op": "type", "who": "Vijay", "text": "50" }, { "op": "type", "who": "Riyadh", "text": "50" }],
      "expect": { "problem": "RM 30.00 remains unassigned.", "remaining": 3000 } },
    { "name": "Auto Calculate OFF: 70/50/80 valid", "total": 20000, "people": ["Vijay", "Riyadh"], "method": "amounts",
      "ops": [{ "op": "autoCalculate", "value": false }, { "op": "type", "who": "Me", "text": "70" },
              { "op": "type", "who": "Vijay", "text": "50" }, { "op": "type", "who": "Riyadh", "text": "80" }],
      "expect": { "shares": [7000, 5000, 8000] } },
    { "name": "Paid for someone: I paid RM100 for Vijay -> Me 0, Vijay 100", "total": 10000, "people": ["Vijay"], "method": "amounts",
      "purpose": "paidFor", "expect": { "shares": [0, 10000] } },
    { "name": "Shares over the total (typed, OFF)", "total": 10000, "people": ["Bijoy"], "method": "amounts",
      "ops": [{ "op": "autoCalculate", "value": false }, { "op": "type", "who": "Me", "text": "30" }, { "op": "type", "who": "Bijoy", "text": "75" }],
      "expect": { "problem": "Shares exceed the total by RM 5.00." } }
  ]
}
