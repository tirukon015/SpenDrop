{
  "$comment": "SpenDrop visual identity, taken from the iOS app (SwiftUI system colours, grouped backgrounds, card radii). Each platform maps these to its own primitives. Light / dark values are Apple's system colours.",
  "accent": "blue",
  "colors": {
    "blue":   { "light": "#007AFF", "dark": "#0A84FF" },
    "green":  { "light": "#34C759", "dark": "#30D158" },
    "indigo": { "light": "#5856D6", "dark": "#5E5CE6" },
    "orange": { "light": "#FF9500", "dark": "#FF9F0A" },
    "pink":   { "light": "#FF2D55", "dark": "#FF375F" },
    "purple": { "light": "#AF52DE", "dark": "#BF5AF2" },
    "red":    { "light": "#FF3B30", "dark": "#FF453A" },
    "teal":   { "light": "#30B0C7", "dark": "#40C8E0" },
    "yellow": { "light": "#FFCC00", "dark": "#FFD60A" },
    "mint":   { "light": "#00C7BE", "dark": "#63E6E2" },
    "cyan":   { "light": "#32ADE6", "dark": "#64D2FF" },
    "gray":   { "light": "#8E8E93", "dark": "#8E8E93" },
    "primary":{ "light": "#000000", "dark": "#FFFFFF" }
  },
  "surfaces": {
    "groupedBackground":          { "light": "#F2F2F7", "dark": "#000000" },
    "secondaryGroupedBackground": { "light": "#FFFFFF", "dark": "#1C1C1E" },
    "tertiaryGroupedBackground":  { "light": "#F2F2F7", "dark": "#2C2C2E" },
    "label":                      { "light": "#000000", "dark": "#FFFFFF" },
    "secondaryLabel":             { "light": "rgba(60,60,67,0.6)",  "dark": "rgba(235,235,245,0.6)" },
    "tertiaryLabel":              { "light": "rgba(60,60,67,0.3)",  "dark": "rgba(235,235,245,0.3)" },
    "separator":                  { "light": "rgba(60,60,67,0.29)", "dark": "rgba(84,84,88,0.6)" }
  },
  "radius": { "card": 16, "field": 14, "control": 12, "pill": 999 },
  "typography": {
    "family": "System (SF Pro on Apple platforms; system-ui elsewhere)",
    "sectionHeader": { "size": 11, "weight": 700, "tracking": 1.0, "case": "uppercase", "color": "secondaryLabel" },
    "amountLarge": { "size": 34, "weight": 700, "numeric": "tabular" }
  },
  "appearance": { "options": ["system", "light", "dark"], "default": "system" },
  "navigation": [
    { "id": "home",         "label": "Home",         "icon": "house.fill" },
    { "id": "transactions", "label": "Transactions", "icon": "list.bullet.rectangle.portrait.fill" },
    { "id": "paybook",      "label": "PayBook",      "icon": "person.crop.rectangle.stack.fill" },
    { "id": "breakdown",    "label": "Breakdown",    "icon": "chart.bar.xaxis" },
    { "id": "more",         "label": "More",         "icon": "ellipsis.circle.fill" }
  ]
}
